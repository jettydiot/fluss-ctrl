    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  },
  "dependencies": {
    "@flussctrl/core": "workspace:*",
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.19",
    "zod": "4.6.7"
  }
