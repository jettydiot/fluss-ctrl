{
  "name": "fluss-ctrl",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.12.0",
    "pnpm": "^10.28.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@flussctrl/api",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --coverage",
    "test:integration": "turbo run test:integration",
    "test:e2e": "node scripts/not-yet-implemented.mjs test:e2e \"Playwright e2e against the preview deployment\" 9",
    "test:docs": "node scripts/not-yet-implemented.mjs test:docs \"quickstart snippets against the preview deployment\" 9",
    "lint": "eslint . && pnpm lint:deps",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "openapi": "node scripts/not-yet-implemented.mjs openapi \"OpenAPI generation from routes\" 7",
    "db:generate": "pnpm --filter @flussctrl/db db:generate",
    "db:migrate:dev": "pnpm --filter @flussctrl/db db:migrate:dev"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "fast-check": "4.10.3",
    "lefthook": "2.2.2",
    "neostandard": "0.14.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
