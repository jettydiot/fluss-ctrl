{
  "name": "@flussctrl/db",
  "version": "0.0.0",
  "description": "Drizzle schema, migrations and org-scoped repositories.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.2",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.3",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.7"
  }
}
